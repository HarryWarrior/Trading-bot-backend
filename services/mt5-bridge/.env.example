# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Required, at least 32 characters. Must be the SAME value as the auth service: mt5-bridge only verifies tokens, it never issues them.
JWT_SECRET_KEY=
# Required, at least 32 characters. Must be the SAME value as INGEST_SERVICE_KEY of the journal service.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_SERVICE_KEY=
JOURNAL_URL=http://localhost:8002
# Optional: JOURNAL_TIMEOUT_SECONDS=10, EA_FILE_PATH=<path to the compiled .ex5>
MONGO_URL=mongodb://localhost:27017
MONGO_DB=bridge_db
CORS_ORIGINS=["http://localhost:3000"]
