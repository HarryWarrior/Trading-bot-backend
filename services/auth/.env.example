# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=auth_db
# Required, at least 32 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
# SMTP is required unless ENVIRONMENT=local. If SMTP_HOST is set, SMTP_FROM_EMAIL is required and SMTP_USER/SMTP_PASSWORD go together. Leave SMTP_HOST empty only with ENVIRONMENT=local to log codes to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
