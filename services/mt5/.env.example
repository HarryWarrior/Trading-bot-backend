# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Required, at least 32 characters. Must be the SAME value as the auth service: mt5 only verifies tokens, it never issues them.
JWT_SECRET_KEY=
# Required, at least 32 characters. Must be the SAME value as INGEST_SERVICE_KEY of the journal service.
INGEST_SERVICE_KEY=
JOURNAL_URL=http://localhost:8002
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=mt5_db
CORS_ORIGINS=["http://localhost:3000"]
# Optional. Broker server offset from UTC in minutes, between -720 and 840 (e.g. 120 = GMT+2, 180 = GMT+3).
# Leave empty to detect it from the latest tick (see README).
# MT5_SERVER_UTC_OFFSET_MINUTES=180
# Recommended. IANA zone of the broker server clock, DST aware and weekend safe (e.g. Europe/Athens for FTMO).
# MT5_SERVER_TIMEZONE=Europe/Athens
