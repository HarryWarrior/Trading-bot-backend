# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Required, at least 32 characters. Must be the SAME value as the auth service: analytics only verifies tokens, it never issues them.
JWT_SECRET_KEY=
JOURNAL_URL=http://localhost:8002
CORS_ORIGINS=["http://localhost:3000"]
