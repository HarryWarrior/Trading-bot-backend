# Copy to .env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=journal_db
# Required, at least 32 characters. Must be the SAME value as the auth service: journal only verifies tokens, it never issues them.
JWT_SECRET_KEY=
# Required, at least 32 characters. Shared secret with the mt5 service (header X-Service-Key on /ingest/mt5).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_SERVICE_KEY=
CORS_ORIGINS=["http://localhost:3000"]
# Upload size cap in megabytes (default 10).
MAX_UPLOAD_MB=10
